{
  "name": "maxtourvietnam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "sync:facts": "node scripts/build-tour-facts-v2.mjs",
    "sync:parity": "node scripts/apply-source-parity.mjs",
    "sync:galleries": "node scripts/build-tour-galleries-v2.mjs",
    "sync:reviews": "node scripts/build-tour-reviews-v2.mjs",
    "sync:main-records": "node scripts/build-tour-main-records.mjs",
    "sync:media": "node scripts/localize-media.mjs",
    "sync:source": "npm run sync:facts && npm run sync:parity && npm run sync:galleries && npm run sync:reviews && npm run sync:main-records && npm run sync:media",
    "db:migrate:local": "wrangler d1 migrations apply maxtourvietnam --local",
    "db:migrate:remote": "wrangler d1 migrations apply maxtourvietnam --remote",
    "db:seed:local": "wrangler d1 execute maxtourvietnam --local --file=seed/tours.sql",
    "db:seed:remote": "wrangler d1 execute maxtourvietnam --remote --file=seed/tours.sql"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
